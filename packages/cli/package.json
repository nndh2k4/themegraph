{
  "name": "themegraph",
  "version": "0.2.1",
  "private": true,
  "description": "Đồ thị tri thức cho Shopify Liquid theme",
  "type": "module",
  "bin": {
    "themegraph": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@themegraph/core": "workspace:*",
    "@themegraph/mcp": "workspace:*",
    "@themegraph/server": "workspace:*",
    "@themegraph/views": "workspace:*"
  },
  "files": [
    "dist",
    "skills"
  ]
}
