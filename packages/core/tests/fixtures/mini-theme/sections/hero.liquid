<section aria-label="{{ 'general.title' | t }}">
  {% if section.settings.show_card %}
    {% render 'card' %}
  {% endif %}
  {% content_for 'blocks' %}
</section>

{% schema %}
{
  "name": "Hero",
  "blocks": [{ "type": "text" }, { "type": "@app" }],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
